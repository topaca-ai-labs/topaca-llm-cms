# The build is disposable (R-03) — never commit it
dist/
.astro/

# Release archive (scripts/release-archive.mjs) — generated, not committed
.release/

# Dependencies
node_modules/

# Material in input/ is private by default (R-04, docs/security.md).
# Publication runs through the approval process; only the structure is committed.
# Exceptions: the READMEs and the brief templates stay visible (both languages).
input/**
!input/*/
!input/README.md
!input/README.de.md
!input/brief.example.md
!input/brief.example.de.md
!input/*/README.md
!input/*/README.de.md

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Secrets (R-04) — never commit them
.env
.env.*

# macOS / IDE
.DS_Store
.idea/
