# Build ist wegwerfbar (R-03) — niemals committen
dist/
.astro/

# Abhängigkeiten
node_modules/

# Material in input/ ist privat by default (R-04, docs/security.md).
# Publiziert wird über den Freigabeprozess, committet wird nur die Struktur.
# Ausnahmen: READMEs und die Brief-Vorlage bleiben sichtbar.
input/**
!input/*/
!input/README.md
!input/brief.example.md
!input/*/README.md

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Geheimnisse (R-04) — niemals committen
.env
.env.*

# macOS / IDE
.DS_Store
.idea/
