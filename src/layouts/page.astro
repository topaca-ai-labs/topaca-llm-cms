---
import { isProduction, site } from '../lib/site';
import Contact from '../components/contact.astro';
import { canonical } from '../lib/route.mjs';
import '../styles/global.css';

type Props = {
  title: string;
  description: string;
  noindex?: boolean;
  contact?: boolean;
};

const { title, description, noindex = false, contact = false } = Astro.props;
// Sichere Grundhaltung (R-21): im development-Zustand ist die Website nicht
// indexierbar, auch wenn niemand daran denkt. Erst production schaltet Indexierung frei.
const robots = noindex || !isProduction ? 'noindex, nofollow' : 'index, follow';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const current = canonical(Astro.url.pathname) ?? '/';
const fullName = title === site.name ? site.name : `${title} — ${site.name}`;
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={robots} />
    <meta property="og:title" content={fullName} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt springen</a>
    <header class="site-header">
      <a class="brand" href="/">{site.name}</a>
      {site.tagline ? <p class="tagline">{site.tagline}</p> : null}
      <nav aria-label="Hauptnavigation">
        <ul>
          {
            site.nav.map((item) => (
              <li>
                <a href={item.href} aria-current={current === canonical(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="inhalt">
      <h1>{title}</h1>
      <slot />
      {contact ? <Contact /> : null}
    </main>

    <footer class="site-footer">
      <nav aria-label="Fußzeile">
        <ul>
          {
            site.footer.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="copyright">© {site.name}</p>
    </footer>
  </body>
</html>
