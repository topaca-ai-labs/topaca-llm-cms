# Line endings: LF in the repository and in every checkout. Without this file a
# Windows checkout produces CRLF — and the builds of two machines are no longer
# byte-identical (R-12), without anyone having done anything wrong.
* text=auto eol=lf

# Mark generated and binary files explicitly
dist/** linguist-generated=false
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
